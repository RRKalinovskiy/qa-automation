{
  "name": "qa-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI- и API-автотесты на Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:mcp": "node --test mcp/saby-checks/test",
    "test:mcp:e2e": "node mcp/saby-checks/test/mcp-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "saby:login": "node scripts/saby-login.mjs",
    "saby:session": "node scripts/saby-session.mjs",
    "mcp:saby": "node mcp/saby-checks/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  }
}
