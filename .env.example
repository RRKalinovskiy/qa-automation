# Базовый URL UI-стенда, например https://demo.example.com
UI_BASE_URL=

# Базовый URL API, например https://api.demo.example.com
API_BASE_URL=

# Токен для API, если требуется. Реальные значения не коммитить.
API_TOKEN=

# Saby Checks MCP: стенд и авторизация.
# Основной способ — npm run saby:login (storageState в .auth/saby.json).
SABY_BASE_URL=https://online.sbis.ru
# SABY_COOKIE=
# SABY_STORAGE_STATE=.auth/saby.json
# SABY_EMPLOYEE_ID=
# SABY_DEPARTMENT_ID=

# Учётная запись стенда из docs/api/sbis-crm-deals.md (пароль не коммитить).
SABY_CRM_USER=crmviewer
SABY_CRM_PASSWORD=
